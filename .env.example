cat > .env.production << 'EOF'
# Django
DEBUG=False
SECRET_KEY=your-generated-secret-key-here

# Hosts
ALLOWED_HOSTS=*.cloudrun.app,your-service-abc123-uc.a.run.app

# CORS & CSRF
CORS_ALLOWED_ORIGINS=https://neurorides.netlify.app
CSRF_TRUSTED_ORIGINS=https://neurorides.netlify.app,https://*.cloudrun.app

# Neon PostgreSQL
DATABASE_URL=postgresql://username:password@ep-cool-sound-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Upstash Redis
REDIS_URL=rediss://default:password@global-shining-cat-12345.upstash.io:6379/0

# JWT
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Service URLs
FRONTEND_URL=https://neurorides.netlify.app
BACKEND_URL=https://your-service-abc123-uc.a.run.app

# Monitoring
ENABLE_METRICS=True
EOF