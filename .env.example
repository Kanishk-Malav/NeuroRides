# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings (SQLite for development, PostgreSQL for production)
# For SQLite (default):
# DATABASE_URL=sqlite:///db.sqlite3

# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/neurorides_db

# Redis Settings
REDIS_URL=redis://localhost:6379/0

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Payment Gateway Settings
# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_secret_here

# Payment Encryption
PAYMENT_ENCRYPTION_KEY=your-encryption-key-here-32-chars-min

# Email Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=your-email@example.com

# Celery Settings
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO

# Security Settings (Production)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# Rate Limiting
RATELIMIT_ENABLE=True

# Frontend URL
FRONTEND_URL=http://localhost:3000

# API Version
API_VERSION=v1

# File Upload Settings
MAX_UPLOAD_SIZE=5242880  # 5MB in bytes

# Session Settings
SESSION_COOKIE_AGE=1209600  # 2 weeks in seconds

# Timezone
TIME_ZONE=UTC

# Language
LANGUAGE_CODE=en-us

# Static Files (Production)
# STATIC_ROOT=/var/www/neurorides/static
# MEDIA_ROOT=/var/www/neurorides/media

# Sentry (Error Tracking - Optional)
# SENTRY_DSN=your-sentry-dsn-here

# AWS S3 (Optional - for file storage)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# Google Maps API (Optional)
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Twilio (Optional - for SMS)
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# SendGrid (Optional - for email)
# SENDGRID_API_KEY=your-sendgrid-api-key

# Feature Flags
ENABLE_WEBSOCKETS=True
ENABLE_CELERY_BEAT=True
ENABLE_ANALYTICS=True
ENABLE_NOTIFICATIONS=True

# Development Settings
DJANGO_SETTINGS_MODULE=neurorides.settings
PYTHONUNBUFFERED=1
